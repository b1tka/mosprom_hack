# ---------- PostgreSQL: users / role / tag (ФИО, роли, e-mail) ----------
DATABASE_URL=postgresql://onboarding:change_me@localhost:5432/onboarding

# ---------- MongoDB: статистика настроения ----------
MONGO_URL=mongodb://onboarding:change_me_mongo@localhost:27018/onboarding
MONGO_DB=onboarding
MONGO_STATS_COLLECTION=stats       # одна запись на сотрудника
MONGO_UID_FIELD=uid                # поле с users.id в этой записи
MONGO_EVENTS_COLLECTION=           # необязательно: история {uid, ts, mood, reason, urgent} -> график динамики

# ---------- Яндекс Почта ----------
# SMTP включить в настройках почты, пароль — «пароль приложения» (id.yandex.ru/security/app-passwords)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl                  # ssl (465) или starttls (587)
SMTP_USER=korsic.stat@yandex.ru       # полный адрес; он же адрес «От»
SMTP_PASSWORD=password
SMTP_FROM_NAME=Корсик · Онбординг
SMTP_PAUSE_SEC=2

# ---------- Отчёты ----------
REPORT_TZ=Europe/Moscow
REPORT_ATTACH_PDF=true
REPORT_RECIPIENT_OVERRIDE=         # для теста: все письма на этот адрес
REPORT_TREND_WEEKS=8
# cron в часовом поясе REPORT_TZ
SCHEDULE_HR=0 9 * * 1-5            # HR-менеджер: каждый будний день в 09:00
SCHEDULE_DIRECTOR=0 9 * * 1        # руководители подразделений: по понедельникам
SCHEDULE_HR_HEAD=0 9 * * 1         # руководитель по подбору и развитию: еженедельный дайджест
