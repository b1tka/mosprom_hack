{%- macro pill(c) -%}
{%- set t = c.tone -%}
<span style="display:inline-block;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;background:{{ tones[t].bg }};color:{{ tones[t].fg }};white-space:nowrap;">{{ c.text }}</span>
{%- endmacro -%}
<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light only"><title>{{ rep.subject }}</title></head>
<body style="margin:0;padding:0;background:#eef1f4;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1b2733;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ rep.preheader }}</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef1f4;"><tr><td align="center" style="padding:20px 10px;">
<table role="presentation" width="680" cellspacing="0" cellpadding="0" style="width:100%;max-width:680px;background:#ffffff;border-radius:14px;overflow:hidden;">
  <tr><td style="background:#0f2a43;padding:26px 30px 22px;">
    <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#a4c617;font-weight:700;">Корсик · Онбординг</div>
    <div style="font-size:24px;line-height:30px;color:#ffffff;font-weight:700;margin-top:8px;">{{ rep.title }}</div>
    <div style="font-size:14px;color:#b9c7d6;margin-top:6px;">{{ rep.subtitle }}</div>
  </td></tr>
  <tr><td style="padding:24px 30px 8px;">
    <div style="font-size:15px;line-height:22px;">Здравствуйте{% if rep.recipient_name %}, {{ rep.recipient_name }}{% endif %}! Ниже — актуальная аналитика по адаптации новых сотрудников.</div>
  </td></tr>
{% for s in rep.sections %}
  {%- if s.type == 'kpis' %}
  <tr><td style="padding:12px 24px 4px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
    {% for i in s['items'] %}{% set t = tones[i.tone or 'neutral'] %}
      <td width="{{ (100 / s['items']|length)|int }}%" style="padding:0 6px;vertical-align:top;">
        <div style="background:{{ t.bg }};border-radius:10px;padding:12px 12px 10px;">
          <div style="font-size:11px;color:#5b6775;text-transform:uppercase;letter-spacing:.5px;">{{ i.label }}</div>
          <div style="font-size:28px;line-height:34px;font-weight:700;color:{{ t.fg }};">{{ i.value }}</div>
          <div style="font-size:11px;color:#5b6775;min-height:14px;">{{ i.hint or '' }}</div>
        </div></td>
    {% endfor %}
    </tr></table></td></tr>
  {%- elif s.type == 'heading' %}
  <tr><td style="padding:26px 30px 4px;"><div style="font-size:18px;font-weight:700;border-bottom:2px solid #a4c617;padding-bottom:8px;">{{ s.text }}</div></td></tr>
  {%- elif s.type == 'text' %}
  <tr><td style="padding:10px 30px;font-size:14px;line-height:21px;color:#3a4654;">{{ s.text }}</td></tr>
  {%- elif s.type == 'callout' %}{% set t = tones[s.tone] %}
  <tr><td style="padding:14px 30px 4px;">
    <div style="background:{{ t.bg }};border-left:4px solid {{ t.bar }};border-radius:8px;padding:14px 16px;">
      <div style="font-size:15px;font-weight:700;color:{{ t.fg }};margin-bottom:6px;">{{ s.title }}</div>
      <ul style="margin:0;padding-left:18px;font-size:14px;line-height:21px;color:#1b2733;">
      {% for it in s['items'] %}<li style="margin:3px 0;">{{ it }}</li>{% endfor %}</ul>
    </div></td></tr>
  {%- elif s.type == 'chart' %}
  <tr><td style="padding:16px 30px 4px;">
    {% if s.title %}<div style="font-size:15px;font-weight:700;">{{ s.title }}</div>{% endif %}
    {% if s.caption %}<div style="font-size:12px;color:#5b6775;margin:2px 0 8px;">{{ s.caption }}</div>{% endif %}
    <img src="cid:{{ s.cid }}" alt="{{ s.title }}" width="620" style="display:block;width:100%;max-width:620px;height:auto;border:0;"></td></tr>
  {%- elif s.type == 'table' %}
  <tr><td style="padding:14px 30px 4px;">
    {% if s.title %}<div style="font-size:15px;font-weight:700;margin-bottom:6px;">{{ s.title }}</div>{% endif %}
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;font-size:12.5px;">
      <tr>{% for c in s.columns %}<td style="padding:8px 6px;background:#f1f4f7;color:#5b6775;font-weight:700;font-size:11px;text-transform:uppercase;border-bottom:1px solid #dfe4ea;">{{ c }}</td>{% endfor %}</tr>
      {% for r in s.rows %}<tr>{% for c in r %}
        <td style="padding:9px 6px;border-bottom:1px solid #eceff2;vertical-align:top;{% if loop.first %}font-weight:600;{% endif %}">
          {%- if c is mapping %}{{ pill(c) }}{% else %}{{ c }}{% endif -%}</td>{% endfor %}</tr>{% endfor %}
    </table></td></tr>
  {%- endif %}
{% endfor %}
  <tr><td style="padding:28px 30px 26px;font-size:12px;line-height:18px;color:#7a8592;">
    Индекс настроения: позитивное = 100, нейтральное = 60, негативное = 25, критическое = 0 (среднее по сообщениям).<br>
    Оценки настроения и темы сформированы ИИ-модулем автоматически; красный флаг ставится при признаках выгорания, конфликта или угрозе увольнения.<br>
    Письмо создано автоматически ботом «Корсик» {{ generated }}. Отвечать на него не нужно.
  </td></tr>
</table></td></tr></table></body></html>
