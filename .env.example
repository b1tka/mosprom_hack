POSTGRES_USER=onboarding
POSTGRES_PASSWORD=change_me
POSTGRES_DB=onboarding
POSTGRES_PORT=5432

REDIS_PORT=6380

# MinIO-совместимый сервер; OpenMaxIO = форк консоли MinIO
S3_IMAGE=ghcr.io/snazy/maxio-release:latest
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=change_me_too
S3_BUCKET=onboarding-files
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

KAFKA_EXTERNAL_PORT=29092
# ответы сотрудников на вопросы HR -> ML (оценка настроения)
KAFKA_TOPIC_ANSWERS=onboarding.answers

# Токен бота из MAX (dev.max.ru -> чат-боты)
BOT_TOKEN=

# ML-сервис (FastAPI)
ML_PORT=8000
# LLM для Ollama (профиль llm). Q4_K_M ~4.7 ГБ; легче: hf.co/bond005/meno-lite-0.1-gguf:IQ3_M (~3.5 ГБ)
MENO_MODEL=hf.co/bond005/meno-lite-0.1-gguf:Q4_K_M

# MongoDB (пока только инфраструктура). На хосте 27017 может быть занят локальным MongoDB
MONGO_PORT=27018
MONGO_DB=onboarding
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_USER=onboarding
MONGO_APP_PASSWORD=change_me_mongo
