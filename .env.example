POSTGRES_USER=onboarding
POSTGRES_PASSWORD=change_me
POSTGRES_DB=onboarding
POSTGRES_PORT=5432

REDIS_PORT=6380

# MinIO-совместимый сервер; OpenMaxIO = форк консоли MinIO
S3_IMAGE=ghcr.io/snazy/maxio-release:latest
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=change_me_too
S3_BUCKET=onboarding-files
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

KAFKA_EXTERNAL_PORT=29092
# ответы сотрудников на вопросы HR -> ML (оценка настроения)
KAFKA_TOPIC_ANSWERS=onboarding.answers
# срочные оценки настроения (red_flag) -> бот -> уведомление закреплённого HR
KAFKA_TOPIC_ALERTS=onboarding.alerts

# Токен бота из MAX (dev.max.ru -> чат-боты)
BOT_TOKEN=

# ML-сервис (FastAPI)
ML_PORT=8000
# LLM для Ollama (профиль llm). Q4_K_M ~4.7 ГБ; легче: hf.co/bond005/meno-lite-0.1-gguf:IQ3_M (~3.5 ГБ)
MENO_MODEL=hf.co/bond005/meno-lite-0.1-gguf:Q4_K_M

# MongoDB: тикеты (бот), статистика настроения stats/events (ML), чтение для отчётов (hr-analytics).
# На хосте 27017 может быть занят локальным MongoDB. Образ строго 7.x (см. INFRASTRUCTURE.md)
MONGO_PORT=27018
MONGO_DB=onboarding
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_USER=onboarding
MONGO_APP_PASSWORD=change_me_mongo

# Отчёты на почту (профиль compose reports: docker compose --profile reports up -d --build hr-analytics)
# SMTP Яндекса включить в настройках ящика; пароль — «пароль приложения» (id.yandex.ru/security/app-passwords)
SMTP_USER=
SMTP_PASSWORD=
# SMTP из этого блока использует и бот: приветственное письмо сотруднику в первый рабочий день (строка 19 сценария)
# Пока отчёты не проверены, все письма идут на этот адрес (в теме [TEST]). Для боевой рассылки очистить.
REPORT_RECIPIENT_OVERRIDE=

# Тестовая админка (профиль compose admin; только на время тестирования, показывает ПДн и переписку).
# Порт публикуется на 127.0.0.1, доступ через SSH-туннель: ssh -L 8080:localhost:8080 <vps>
# ADMIN_ACCESS: off — /admin отключена; hr — код только для hr/hr_head; anyone — любой пользователь бота (полный доступ к базам!)
ADMIN_ACCESS=off
ADMIN_URL=http://localhost:8080
# длинные случайные строки: openssl rand -hex 32
ADMIN_API_TOKEN=
SESSION_SECRET=
